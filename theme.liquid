<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title></title>

        {% comment %}  Klaviyo form embed code - Rusho  
        <div class="klaviyo-form-Uqdg3K"></div> 
        {% endcomment %}

         <style>
/*This css for Shoppay installment text issue - Rusho*/
          shopify-payment-terms {
          display: none;
          background: #F5F0E8;
          padding: 10px 12px;
         /* border-radius: 8px; */
          margin-top: 10px;
          color: #162D3A !important;
          font-size: 14px;
          line-height: 1.5;
        }

        shopify-payment-terms * {
          color: #162D3A !important;
        }

        shopify-payment-terms a {
          color: #162D3A !important;
          text-decoration: underline;
        }


      /* Section Container */
      .klaviyo-form-Uqdg3K {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      /* Make the inner column a flex wrap container */
      .klaviyo-form-Uqdg3K form > div:first-child {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 8px !important;
      }

      /* All rows default to full width */
      .klaviyo-form-Uqdg3K [data-testid="form-row"] {
        width: 100% !important;
        flex: 1 1 100% !important;
        justify-content: center !important;
      }

      /* Only email and button rows go inline / auto width */
      .klaviyo-form-Uqdg3K [data-testid="form-row"]:has(input[type="email"]),
      .klaviyo-form-Uqdg3K [data-testid="form-row"]:has(button) {
        flex: 0 0 auto !important;
        width: auto !important;
      }

      /* Email Input */
      .klaviyo-form-Uqdg3K input[type="email"] {
        width: 390px !important;
        height: 56px !important;
        border: 1px solid #cfd6d8 !important;
        border-radius: 8px !important;
        background: #ffffff !important;
        padding: 0 16px !important;
        font-size: 18px !important;
        color: #2d3748 !important;
        box-shadow: none !important;
      }

      /* Placeholder */
      .klaviyo-form-Uqdg3K input[type="email"]::placeholder {
        color: #6b7280 !important;
      }

      /* Subscribe Button */
      .klaviyo-form-Uqdg3K button {
        width: 126px !important;
        height: 56px !important;
        border-radius: 8px !important;
        border: none !important;
        background: #e4c81c !important;
        color: #222 !important;
        font-size: 16px !important;
        font-weight: 500 !important;
        letter-spacing: 1px !important;
        text-transform: uppercase !important;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .klaviyo-form-Uqdg3K button:hover {
        opacity: 0.9;
      }

      /* Mobile */
      @media (max-width: 767px) {
        .klaviyo-form-Uqdg3K [data-testid="form-row"]:has(input[type="email"]),
        .klaviyo-form-Uqdg3K [data-testid="form-row"]:has(button) {
          flex: 1 1 100% !important;
          width: 100% !important;
        }

        .klaviyo-form-Uqdg3K input[type="email"] {
          width: 100% !important;
        }

        .klaviyo-form-Uqdg3K button {
          width: 100% !important;
        }
      }
        
    </style>
    </head>
    <body>

    </body>
    </html>