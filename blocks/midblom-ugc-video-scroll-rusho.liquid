{% liquid
  assign s = block.settings
%}

<section
  class="midblom-ugc color-{{ s.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
>
  <div class="midblom-ugc__inner">
    <header class="midblom-ugc__header">
      {%- if s.eyebrow != blank -%}
        <span class="midblom-ugc__eyebrow">{{ s.eyebrow }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="midblom-ugc__heading">{{ s.heading }}</h2>
      {%- endif -%}
    </header>
  </div>

  <div class="midblom-ugc__track-wrap" aria-label="Customer videos">
    {% comment %}
    <ul class="midblom-ugc__track" role="list">
      {% content_for 'blocks' %}
    </ul>
    {% endcomment %}
    <!-- Duplicated strip for seamless loop -->
    <ul class="midblom-ugc__track midblom-ugc__track--clone" role="presentation" aria-hidden="true">
      {% content_for 'blocks' %}
    </ul>
  </div>
</section>

{% stylesheet %}
  /* ── Section shell ── */
  .midblom-ugc {
    width: 100%;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .midblom-ugc__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: 0 20px;
  }

  .midblom-ugc__header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .midblom-ugc__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .midblom-ugc__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    margin: 0;
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-foreground-heading);
  }

  /* ── Scrolling track wrapper ── */
  .midblom-ugc__track-wrap {
    display: flex;          /* two strips side-by-side */
    width: 100%;
    overflow: hidden;
    /* Fade edges */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 6%,
      black 94%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 6%,
      black 94%,
      transparent 100%
    );
  }

  /* Pause on hover/focus-within */
  .midblom-ugc__track-wrap:hover .midblom-ugc__track,
  .midblom-ugc__track-wrap:focus-within .midblom-ugc__track {
    animation-play-state: paused;
  }

  /* ── Each strip ── */
  .midblom-ugc__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;    /* ALL items in one horizontal row */
    flex-wrap: nowrap;
    gap: 12px;
    flex-shrink: 0;         /* Never shrink — stay full natural width */
    animation: ugc-scroll 30s linear infinite;
  }

  /* Clone strip continues without gap */
  .midblom-ugc__track--clone {
    padding-left: 12px;
  }

  @keyframes ugc-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  /* ── Individual cells ── */
  .midblom-ugc__cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;         /* Never shrink */
    width: clamp(160px, 22vw, 260px);   /* Responsive card width */
  }

  /* ── Media tile ── */
  .midblom-ugc__media {
    position: relative;
    aspect-ratio: 9 / 16;
    background: #1f1f1b;
    border-radius: 12px;
    overflow: hidden;
    color: #f6f1ea;
  }

  .midblom-ugc__video,
  .midblom-ugc__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .midblom-ugc__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: rgba(246, 241, 234, 0.55);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    background: linear-gradient(135deg, #1a2540 0%, #2f4034 100%);
  }

  .midblom-ugc__play {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(246, 241, 234, 0.95);
    color: #1a2540;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .midblom-ugc__play:hover {
    transform: scale(1.1);
  }

  .midblom-ugc__creator {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(31, 31, 27, 0.65);
    color: #f6f1ea;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 500;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* ── Product chip ── */
  .midblom-ugc__product {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-foreground-heading);
    font-size: 0.75rem;
    font-weight: 500;
    align-self: center;
    white-space: nowrap;
  }

  .midblom-ugc__product img,
  .midblom-ugc__product-ph {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #e6decf;
    object-fit: cover;
    flex-shrink: 0;
  }

  /* ── Mobile tweaks ── */
  @media (max-width: 749px) {
    .midblom-ugc__cell {
      width: clamp(130px, 42vw, 200px);
    }
    .midblom-ugc__track {
      gap: 8px;
      animation-duration: 22s;
    }
    .midblom-ugc__track--clone {
      padding-left: 8px;
    }
  }

  /* Respect reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .midblom-ugc__track {
      animation: none;
    }
    .midblom-ugc__track-wrap {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .midblom-ugc__track--clone {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Play / pause individual videos on button click */
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.midblom-ugc__play');
    if (!btn) return;
    const media = btn.closest('.midblom-ugc__media');
    const video = media?.querySelector('video');
    if (!video) return;
    if (video.paused) {
      video.play();
      btn.style.opacity = '0';
      btn.style.pointerEvents = 'none';
    } else {
      video.pause();
      btn.style.opacity = '1';
      btn.style.pointerEvents = '';
    }
  });

  /* Keep clone strip's videos muted & synced; they are purely decorative */
  document.querySelectorAll('.midblom-ugc__track--clone video').forEach(v => {
    v.muted = true;
  });
{% endjavascript %}

{% schema %}
{
  "name": "MIDBLOM UGC Grid",
  "blocks": [{ "type": "midblom-ugc-video-item-scroll-rusho" }],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TRUSTED BY MIDBLOM CUSTOMERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real women. Real routines." },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "UGC Video Section - Rusho",
      "category": "Product"
    }
  ]
}
{% endschema %}
