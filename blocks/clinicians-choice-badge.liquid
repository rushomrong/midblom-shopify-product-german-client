  <!-- Main copy line -->
  <div>
    <p class="frontrow-main-copy">
      <span class="frontrow-provider-inline-group">
        <span class="frontrow-bold">{{ clinician_count }} clinicians</span>
      </span>
      share this on <span class="frontrow-italics">FrontrowMD</span>
      <span class="frontrow-nowrap">without compensation.</span>
      <span>
        <button
          class="frontrow-learn-more-thin"
          onclick="openFrontrowModal()"
          aria-label="Click to learn more about the clinicians sharing this product"
          type="button"
        >
          <p>Learn more</p>
        </button>
      </span>
    </p>
  </div>

  <!-- CTA row: avatars + "Read their reviews" -->
  <div class="frontrow-cta">
    <span class="frontrow-images">
      <img
        src="https://assets.app.thefrontrowhealth.com/3rcqsbxbx2wrqmniqs8mnfmijqf1"
        alt="Clinician 1"
        class="frontrow-avatar frontrow-avatar--0"
      />
      <img
        src="https://assets.app.thefrontrowhealth.com/jijjnma3wz2ktevmvpuoewdnubm0"
        alt="Clinician 2"
        class="frontrow-avatar frontrow-avatar--1"
      />
      <img
        src="https://assets.app.thefrontrowhealth.com/j3dpo0lkq5u6etn5fezqeizarel4"
        alt="Clinician 3"
        class="frontrow-avatar frontrow-avatar--2"
      />
    </span>

   <button
      class="frontrow-testimonial-cta"
      onclick="frontrowScrollToReviews()"
      aria-label="Click to read reviews from clinicians sharing this product"
      type="button"
    >
      <p>Read their reviews</p>
      <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none">
        <path d="M1.33057 9.5L5.33057 5.5L1.33057 1.5" stroke="#212121" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  /* ── Scoped to #frontrow-embedded to avoid conflicts with Shopify theme ── */
  #frontrow-embedded {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: unset;
    font-family: inherit;
  }

  #frontrow-embedded .frontrow-heading {
    display: flex;
    flex-direction: row;
    gap: 4px;
    align-items: center;
  }

  #frontrow-embedded .frontrow-left-laurels,
  #frontrow-embedded .frontrow-right-laurels {
    height: 18px;
    display: flex;
    align-items: center;
  }

  #frontrow-embedded .frontrow-right-laurels {
    margin-left: 1px;
  }

  #frontrow-embedded .frontrow-caduceus-icon {
    display: flex;
    height: 15px;
    align-items: center;
  }

  #frontrow-embedded .frontrow-heading-text {
    font-size: 18px;
    font-weight: 500;
    line-height: normal;
    font-family: "Lora", Georgia, serif;
    letter-spacing: 0.3px;
    color: #212121;
    margin: 0;
  }

  #frontrow-embedded p {
    color: #212121;
    margin: 0;
  }

  #frontrow-embedded .frontrow-main-copy {
    display: block;
    line-height: 22px;
    font-size: 14px;
  }

  #frontrow-embedded .frontrow-provider-inline-group {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    vertical-align: middle;
    margin-top: -3px;
  }

  #frontrow-embedded .frontrow-bold {
    display: inline;
    font-weight: 600;
  }

  #frontrow-embedded .frontrow-italics {
    display: inline;
    font-style: italic;
  }

  #frontrow-embedded .frontrow-nowrap {
    white-space: nowrap;
  }

  #frontrow-embedded button {
    padding: 0;
    border: none;
    background-color: transparent;
    cursor: pointer;
  }

  #frontrow-embedded .frontrow-learn-more-thin > p {
    color: #212121;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 0.5px;
  }

  #frontrow-embedded .frontrow-cta {
    display: flex;
    flex-direction: row;
    gap: 10px;
    align-items: center;
    margin-top: 2px;
  }

  #frontrow-embedded .frontrow-images {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-right: 6px;
  }

  #frontrow-embedded .frontrow-avatar {
    width: 24px;
    height: 24px;
    border-radius: 100px;
    object-fit: cover;
    background-color: #ababab;
    border: 2px #faf7f0 solid;
    display: inline-block;
    vertical-align: middle;
  }

  #frontrow-embedded .frontrow-avatar--1,
  #frontrow-embedded .frontrow-avatar--2 {
    margin-left: -8px;
  }

  #frontrow-embedded .frontrow-testimonial-cta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #frontrow-embedded .frontrow-testimonial-cta > p {
    color: #212121;
    font-weight: 600;
  }

  #frontrow-embedded .frontrow-testimonial-cta > svg {
    margin-top: 2px;
  }
</style>

<script>
  function frontrowScrollToReviews() {
    var target = document.getElementById('judgeme_product_reviews');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

