{% liquid
  assign s = section.settings
  assign p = all_products[s.product]
  assign modal_id = 'midblom-fp-ingr-' | append: section.id
%}

<section class="midblom-fp color-{{ s.color_scheme }}">
  <div class="midblom-fp__inner">
    <header class="midblom-fp__header">
      {%- if s.eyebrow != blank -%}<span class="midblom-fp__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="midblom-fp__heading">{{ s.heading }}</h2>{%- endif -%}
    </header>

    <article class="midblom-fp__card">
      <div class="midblom-fp__media-wrap">
        <div class="midblom-fp__media">
          {%- if p.featured_media != blank -%}
            <img src="{{ p.featured_media | image_url: width: 1200 }}" alt="{{ p.title | escape }}" loading="lazy" data-fp-main-img>
          {%- elsif s.fallback_image != blank -%}
            <img src="{{ s.fallback_image | image_url: width: 1200 }}" alt="{{ s.fallback_title | escape }}" loading="lazy" data-fp-main-img>
          {%- else -%}
            <div class="midblom-fp__media-ph"><span>Product image</span></div>
          {%- endif -%}
          {%- if s.badge_text != blank -%}<span class="midblom-fp__badge">{{ s.badge_text }}</span>{%- endif -%}
        </div>

        {%- liquid
          assign auto_pull = s.auto_pull_product_images
          if auto_pull == nil
            assign auto_pull = true
          endif
          assign thumb_count = 0
        -%}

        {%- capture thumbs_html -%}
          {%- if auto_pull and p.images.size > 0 -%}
            {%- for img in p.images limit: 10 -%}
              {%- assign thumb_count = thumb_count | plus: 1 -%}
              <button type="button"
                      class="midblom-fp__thumb{% if forloop.first %} is-active{% endif %}"
                      data-fp-thumb
                      data-img="{{ img | image_url: width: 1200 }}"
                      aria-label="View image {{ forloop.index }}">
                <img src="{{ img | image_url: width: 200 }}" alt="" loading="lazy" width="80" height="80">
              </button>
            {%- endfor -%}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
              {%- assign thumb_count = thumb_count | plus: 1 -%}
              <button type="button"
                      class="midblom-fp__thumb{% if thumb_count == 1 %} is-active{% endif %}"
                      data-fp-thumb
                      data-img="{{ block.settings.image | image_url: width: 1200 }}"
                      aria-label="{{ block.settings.alt | default: 'View additional image' }}"
                      {{ block.shopify_attributes }}>
                <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="80" height="80">
              </button>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if thumb_count > 1 -%}
          <div class="midblom-fp__thumbs" role="list" aria-label="Product images">
            {{ thumbs_html }}
          </div>
        {%- endif -%}

        {%- if s.show_ingredients -%}
          <button type="button" class="midblom-fp__ingr-btn" data-ingr-open="{{ modal_id }}">
            <span>{{ s.ingredients_button_text | default: 'View ingredients' }}</span>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      <div class="midblom-fp__body">
        {%- if s.show_review_row -%}
          <div class="midblom-fp__review-row">
            <span class="midblom-fp__review-stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 20 20" width="14" height="14" fill="#EDD020"><path d="M10 1l2.6 6 6.4.6-4.9 4.4 1.5 6.4L10 15l-5.6 3.4 1.5-6.4L1 7.6 7.4 7z"/></svg>
              {%- endfor -%}
            </span>
            {%- if s.review_count != blank -%}<strong class="midblom-fp__review-count">({{ s.review_count }})</strong>{%- endif -%}
            {%- if s.review_text != blank -%}<span class="midblom-fp__review-text">{{ s.review_text }}</span>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.eyebrow_left != blank or s.eyebrow_right != blank -%}
          <div class="midblom-fp__eyebrows">
            {%- if s.eyebrow_left != blank -%}<span class="midblom-fp__eyebrow">{{ s.eyebrow_left }}</span>{%- endif -%}
            {%- if s.eyebrow_left != blank and s.eyebrow_right != blank -%}<span class="midblom-fp__eyebrow-sep" aria-hidden="true">·</span>{%- endif -%}
            {%- if s.eyebrow_right != blank -%}<span class="midblom-fp__eyebrow">{{ s.eyebrow_right }}</span>{%- endif -%}
          </div>
        {%- elsif s.tagline != blank -%}
          <span class="midblom-fp__tagline">{{ s.tagline }}</span>
        {%- endif -%}

        {%- liquid
          assign title_text = s.custom_heading
          if title_text == blank
            if p
              assign title_text = p.title
            else
              assign title_text = s.fallback_title | default: 'The Midsummer System'
            endif
          endif
        -%}
        <h3 class="midblom-fp__title">{{ title_text }}</h3>
        {%- if s.subtitle != blank -%}<p class="midblom-fp__subtitle">{{ s.subtitle }}</p>{%- endif -%}

        {%- liquid
          assign price_sale = '$139'
          assign price_compare = ''
          assign save_pct = 0
          if p
            assign price_sale = p.price | money
            if p.compare_at_price > p.price
              assign price_compare = p.compare_at_price | money
              assign diff = p.compare_at_price | minus: p.price
              assign save_pct = diff | times: 100 | divided_by: p.compare_at_price
            endif
          else
            assign price_sale = s.fallback_price | default: '$139'
            if s.fallback_compare != blank
              assign price_compare = s.fallback_compare
            endif
          endif
        -%}
        <div class="midblom-fp__price-row">
          {%- if save_pct > 0 or s.show_save_pill -%}
            <span class="midblom-fp__save-pill">
              {%- if save_pct > 0 -%}SAVE {{ save_pct }}%{%- else -%}{{ s.save_pill_text | default: 'SAVE 20%' }}{%- endif -%}
            </span>
          {%- endif -%}
          <strong>{{ s.price_label | default: 'One-time purchase' }}</strong>
          <span class="midblom-fp__price-row__nums">
            <span class="midblom-fp__price-row__sale">{{ price_sale }}</span>
            {%- if price_compare != blank -%}
              <span class="midblom-fp__price-row__compare">{{ price_compare }}</span>
            {%- endif -%}
          </span>
        </div>

        {%- if s.bullets != blank -%}
          <ul class="midblom-fp__bullets">
            {%- assign lines = s.bullets | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign t = line | strip -%}
              {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.show_benefits_grid -%}
          {%- assign benefit_count = 0 -%}
          {%- for n in (1..6) -%}
            {%- assign tk = 'benefit_' | append: n | append: '_text' -%}
            {%- if s[tk] != blank -%}{%- assign benefit_count = benefit_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if benefit_count > 0 -%}
            <ul class="midblom-fp__benefits-grid" role="list">
              {%- for n in (1..6) -%}
                {%- liquid
                  assign tk = 'benefit_' | append: n | append: '_text'
                  assign ik = 'benefit_' | append: n | append: '_icon'
                  assign bt = s[tk]
                  assign bi = s[ik] | default: 'leaf'
                -%}
                {%- if bt != blank -%}
                  <li class="midblom-fp__benefit">
                    <span class="midblom-fp__benefit-icon" aria-hidden="true">{%- render 'icon', icon: bi -%}</span>
                    <span class="midblom-fp__benefit-text">{{ bt }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}

        {%- if s.show_offer_options -%}
          <div class="midblom-fp__offers">
            <label class="midblom-fp__offer midblom-fp__offer--featured">
              <input type="radio" name="midblom-fp-offer" checked>
              <div>
                <strong>{{ s.offer_a_title | default: 'One-time purchase' }}</strong>
                <span>{{ s.offer_a_desc | default: 'Free shipping over $50' }}</span>
              </div>
              <span class="midblom-fp__offer-price">{{ s.offer_a_price | default: '$139' }}</span>
            </label>
            <label class="midblom-fp__offer">
              <input type="radio" name="midblom-fp-offer">
              <div>
                <strong>{{ s.offer_b_title | default: 'Bundle & save' }}</strong>
                <span>{{ s.offer_b_desc | default: 'Order any 2 — save $20' }}</span>
              </div>
              <span class="midblom-fp__offer-price">{{ s.offer_b_price | default: '$258' }}</span>
            </label>
          </div>
        {%- endif -%}

        {%- if s.show_scarcity -%}
          <div class="midblom-fp__scarcity" role="alert">
            <span class="midblom-fp__scarcity-icon" aria-hidden="true">
              {%- render 'icon', icon: s.scarcity_icon | default: 'fire' -%}
            </span>
            <div class="midblom-fp__scarcity-copy">
              {%- if s.scarcity_title != blank -%}<strong>{{ s.scarcity_title }}</strong>{%- endif -%}
              {%- if s.scarcity_body != blank -%}<div>{{ s.scarcity_body }}</div>{%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <a href="{% if p %}{{ p.url }}{% else %}{{ s.cta_link | default: '#' }}{% endif %}" class="midblom-fp__cta">
          {{ s.cta_text | default: 'Add to cart' }}{%- if s.show_cta_price -%} — {% if p %}{{ p.price | money }}{% else %}{{ s.fallback_price | default: '$139' }}{% endif %}{%- endif -%}
        </a>

        {%- if s.trust_line != blank -%}
          <p class="midblom-fp__trust">{{ s.trust_line }}</p>
        {%- endif -%}

        {%- if s.show_trust_row -%}
          <ul class="midblom-fp__trust-row" role="list">
            <li>
              <span class="midblom-fp__trust-icon" aria-hidden="true">{%- render 'icon', icon: 'heart' -%}</span>
              <span class="midblom-fp__trust-label">{{ s.trust_1_label | default: 'Gentle on skin and planet' }}</span>
            </li>
            <li>
              <span class="midblom-fp__trust-icon" aria-hidden="true">{%- render 'icon', icon: 'return' -%}</span>
              <span class="midblom-fp__trust-label">{{ s.trust_2_label | default: '60-day money-back guarantee' }}</span>
            </li>
            <li>
              <span class="midblom-fp__trust-icon" aria-hidden="true">{%- render 'icon', icon: 'truck' -%}</span>
              <span class="midblom-fp__trust-label">{{ s.trust_3_label | default: 'Free shipping over $50' }}</span>
            </li>
          </ul>
        {%- endif -%}
      </div>
    </article>
  </div>

  {%- if s.show_ingredients -%}
    <div class="midblom-fp__modal" id="{{ modal_id }}" role="dialog" aria-modal="true" aria-labelledby="{{ modal_id }}-title" aria-hidden="true">
      <div class="midblom-fp__modal-backdrop" data-ingr-close="{{ modal_id }}"></div>
      <div class="midblom-fp__modal-panel" tabindex="-1">
        <button type="button" class="midblom-fp__modal-close" data-ingr-close="{{ modal_id }}" aria-label="Close ingredients">
          <svg viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path d="M3 3l10 10M13 3L3 13"/>
          </svg>
        </button>

        <div class="midblom-fp__modal-content">
          <header class="midblom-fp__modal-header">
            {%- if s.modal_eyebrow != blank -%}<span class="midblom-fp__modal-eyebrow">{{ s.modal_eyebrow }}</span>{%- endif -%}
            {%- if s.modal_heading != blank -%}<h2 id="{{ modal_id }}-title" class="midblom-fp__modal-heading">{{ s.modal_heading }}</h2>{%- endif -%}
            {%- if s.modal_subheading != blank -%}<div class="midblom-fp__modal-sub">{{ s.modal_subheading }}</div>{%- endif -%}
          </header>

          <div class="midblom-fp__ingr-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'ingredient' -%}
                {%- liquid assign b = block.settings -%}
                <div class="midblom-fp__ingr-card" {{ block.shopify_attributes }}>
                  <div class="midblom-fp__ingr-icon" aria-hidden="true">
                    {%- if b.icon_image != blank -%}
                      <img src="{{ b.icon_image | image_url: width: 200 }}" alt="" width="80" height="80" loading="lazy">
                    {%- else -%}
                      {%- comment -%}
                        Match on BOTH b.icon (select value) AND b.name (handleized) so existing
                        blocks saved before the schema change continue to work.
                      {%- endcomment -%}
                      {%- liquid
                        assign icon_key = b.icon | strip
                        assign name_key = b.name | handleize
                      -%}
                      {%- if icon_key == 'Cloudberry' or name_key == 'cloudberry' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Cloudberry' -%}
                      {%- elsif icon_key == 'Lingonberry' or name_key == 'lingonberry' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Lingonberry' -%}
                      {%- elsif icon_key == 'Birch-extract' or name_key == 'birch-extract' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Birch-extract' -%}
                      {%- elsif icon_key == 'Sea-buckthorn' or name_key == 'sea-buckthorn' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Sea-buckthorn' -%}
                      {%- elsif icon_key == 'Arctic-crowberry' or name_key == 'arctic-crowberry' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Arctic-crowberry' -%}
                      {%- elsif icon_key == 'Vitamin-E' or name_key == 'vitamin-e' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Vitamin-E' -%}
                      {%- elsif icon_key == 'Rosehip' or name_key == 'rosehip' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Rosehip' -%}
                      {%- elsif icon_key == 'Squalane' or name_key == 'squalane' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Squalane' -%}
                      {%- elsif icon_key == 'Beeswax' or name_key == 'beeswax' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Beeswax' -%}
                      {%- elsif icon_key == 'Chamomile' or name_key == 'chamomile' -%}
                        {%- render 'rusho-icons', rusho-icon: 'Chamomile' -%}
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                  {%- if b.tag != blank -%}<span class="midblom-fp__ingr-tag">{{ b.tag }}</span>{%- endif -%}
                  {%- if b.name != blank -%}<h3 class="midblom-fp__ingr-name">{{ b.name }}</h3>{%- endif -%}
                  {%- if b.description != blank -%}<div class="midblom-fp__ingr-desc">{{ b.description }}</div>{%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if s.show_promise_strip -%}
            <ul class="midblom-fp__promise-strip" role="list">
              <li><span aria-hidden="true">{%- render 'icon', icon: 'plant' -%}</span><span>{{ s.promise_1 | default: '0 PESTICIDES' }}</span></li>
              <li><span aria-hidden="true">{%- render 'icon', icon: 'lightning_bolt' -%}</span><span>{{ s.promise_2 | default: '0 HORMONE DISRUPTORS' }}</span></li>
              <li><span aria-hidden="true">{%- render 'icon', icon: 'leaf' -%}</span><span>{{ s.promise_3 | default: '100% NATURAL' }}</span></li>
              <li><span aria-hidden="true">{%- render 'icon', icon: 'check_box' -%}</span><span>{{ s.promise_4 | default: '3RD PARTY TESTED' }}</span></li>
            </ul>
          {%- endif -%}

          {%- if s.inci_intro != blank or s.inci_list != blank -%}
            <div class="midblom-fp__inci">
              {%- if s.inci_intro != blank -%}
                <div class="midblom-fp__inci-intro">{{ s.inci_intro }}</div>
              {%- endif -%}
              {%- if s.inci_list != blank -%}
                <div class="midblom-fp__inci-list">{{ s.inci_list }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <button type="button" class="midblom-fp__modal-close-bottom" data-ingr-close="{{ modal_id }}">
            {{ s.modal_close_text | default: 'Close' }}
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .midblom-fp {
    width: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
    padding: clamp(32px, 4.5vw, 64px) 0;
  }
  .midblom-fp__inner {
    max-width: var(--page-width, 1280px);
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  @media (min-width: 990px) {
    .midblom-fp__inner { max-width: 960px; }
  }
  .midblom-fp__header {
    display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center;
    margin-bottom: 32px;
  }
  .midblom-fp__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--color-primary);
  }
  .midblom-fp__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.25rem); margin: 0;
    font-weight: 500; line-height: 1.15; max-width: 720px;
    color: var(--color-foreground-heading);
  }
  .midblom-fp__card {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  @media (max-width: 749px) { .midblom-fp__card { grid-template-columns: 1fr; } }
  .midblom-fp__media-wrap {
    display: flex; flex-direction: column; gap: 10px; min-width: 0;
  }
  .midblom-fp__media {
    position: relative; aspect-ratio: 1/1;
    background: #C4D8DC; border-radius: 8px; overflow: hidden;
  }
  @media (min-width: 990px) {
    .midblom-fp__media { aspect-ratio: 1/1; max-height: 420px; }
    .midblom-fp__card { grid-template-columns: 0.95fr 1.05fr; align-items: start; gap: clamp(32px, 4vw, 56px); }
  }
  .midblom-fp__media img { width: 100%; height: 100%; object-fit: cover; }
  .midblom-fp__media-ph {
    width: 100%; height: 100%; display: grid; place-items: center;
    color: rgba(22,45,58,0.4); font-family: var(--font-subheading--family);
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.14em;
    border: 1px dashed rgba(22,45,58,0.25);
  }
  .midblom-fp__badge {
    position: absolute; top: 16px; right: 16px;
    background: #EDD020; color: #162D3A; font-family: var(--font-subheading--family);
    font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase;
    padding: 6px 12px; border-radius: 4px; font-weight: 600;
  }
  .midblom-fp__thumbs {
    list-style: none; margin: 0; padding: 4px 2px;
    display: flex; gap: 8px; overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    scrollbar-width: thin; scrollbar-color: rgba(13, 30, 40, 0.25) transparent;
  }
  .midblom-fp__thumbs::-webkit-scrollbar { height: 4px; }
  .midblom-fp__thumbs::-webkit-scrollbar-thumb { background: rgba(13, 30, 40, 0.25); border-radius: 4px; }
  .midblom-fp__thumbs::-webkit-scrollbar-track { background: transparent; }
  .midblom-fp__thumb {
    flex: 0 0 auto; width: 64px; height: 64px; padding: 0; margin: 0;
    border-radius: 6px; border: 2px solid transparent;
    background: var(--color-background); overflow: hidden; cursor: pointer;
    scroll-snap-align: start; position: relative;
    transition: border-color .15s ease, transform .15s ease;
  }
  .midblom-fp__thumb:hover { transform: translateY(-1px); border-color: rgba(13, 30, 40, 0.20); }
  .midblom-fp__thumb:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .midblom-fp__thumb.is-active { border-color: var(--color-primary, #EDD020); }
  .midblom-fp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (min-width: 990px) {
    .midblom-fp__thumb { width: 72px; height: 72px; }
    .midblom-fp__thumbs { gap: 10px; }
  }
  .midblom-fp__body { display: flex; flex-direction: column; gap: 16px; }
  .midblom-fp__review-row {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-subheading--family); font-size: 0.75rem;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-foreground-heading); line-height: 1.2;
  }
  .midblom-fp__review-stars { display: inline-flex; gap: 1px; }
  .midblom-fp__review-count {
    color: var(--color-foreground-heading); font-weight: 700;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px;
  }
  .midblom-fp__eyebrows {
    display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 2px;
  }
  .midblom-fp__eyebrow {
    font-family: var(--font-subheading--family); font-size: 0.6875rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: #162D3A; opacity: 0.65;
  }
  .midblom-fp__eyebrow-sep { color: #162D3A; opacity: 0.4; }
  .midblom-fp__tagline {
    font-family: var(--font-subheading--family); font-size: 0.75rem; letter-spacing: 0.20em;
    text-transform: uppercase; color: #162D3A; font-weight: 700; opacity: 0.75;
  }
  .midblom-fp__title {
    margin: 0; font-family: var(--font-heading--family);
    font-size: clamp(1.625rem, 3.4vw, 2.5rem); font-weight: 600;
    line-height: 1.1; letter-spacing: -0.005em; color: var(--color-foreground-heading);
  }
  .midblom-fp__subtitle { margin: 0; font-size: 1rem; line-height: 1.5; opacity: 0.85; }
  .midblom-fp__price-row {
    position: relative; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 4px;
    padding: 24px 20px 20px;
