{% liquid
  assign s = section.settings
  assign p = all_products[s.product]
  assign modal_id = 'midblom-fp-ingr-' | append: section.id
%}

<section class="midblom-fp color-{{ s.color_scheme }}">
  <div class="midblom-fp__inner">
    <header class="midblom-fp__header">
      {%- if s.eyebrow != blank -%}
        <span class="midblom-fp__eyebrow">{{ s.eyebrow }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="midblom-fp__heading">{{ s.heading }}</h2>
      {%- endif -%}
    </header>

    <article class="midblom-fp__card">
      {%- comment -%} Media wrap = main image + thumbnail carousel below (Froya-style) {%- endcomment -%}
      <div class="midblom-fp__media-wrap">
        <div class="midblom-fp__media">
          {%- if p.featured_media != blank -%}
            <img
              src="{{ p.featured_media | image_url: width: 1200 }}"
              alt="{{ p.title | escape }}"
              loading="lazy"
              data-fp-main-img
            >
          {%- elsif s.fallback_image != blank -%}
            <img
              src="{{ s.fallback_image | image_url: width: 1200 }}"
              alt="{{ s.fallback_title | escape }}"
              loading="lazy"
              data-fp-main-img
            >
          {%- else -%}
            <div class="midblom-fp__media-ph"><span>Product image</span></div>
          {%- endif -%}
          {%- if s.badge_text != blank -%}
            <span class="midblom-fp__badge">{{ s.badge_text }}</span>
          {%- endif -%}
        </div>

        {%- comment -%}
          Thumbnail strip — combines the selected product's images with any
          `gallery_image` blocks. Scrollable + swipeable on mobile, click to
          swap the main image.
        {%- endcomment -%}
        {%- liquid
          assign auto_pull = s.auto_pull_product_images
          if auto_pull == null
            assign auto_pull = true
          endif
          assign thumb_count = 0
        -%}

        {%- capture thumbs_html -%}
          {%- if auto_pull and p.images.size > 0 -%}
            {%- for img in p.images limit: 10 -%}
              {%- assign thumb_count = thumb_count | plus: 1 -%}
              <button type="button"
                      class="midblom-fp__thumb{% if forloop.first %} is-active{% endif %}"
                      data-fp-thumb
                      data-img="{{ img | image_url: width: 1200 }}"
                      aria-label="View image {{ forloop.index }}">
                <img src="{{ img | image_url: width: 200 }}" alt="" loading="lazy" width="80" height="80">
              </button>
            {%- endfor -%}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
              {%- assign thumb_count = thumb_count | plus: 1 -%}
              <button type="button"
                      class="midblom-fp__thumb{% if thumb_count == 1 %} is-active{% endif %}"
                      data-fp-thumb
                      data-img="{{ block.settings.image | image_url: width: 1200 }}"
                      aria-label="{{ block.settings.alt | default: 'View additional image' }}"
                      {{ block.shopify_attributes }}>
                <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="80" height="80">
              </button>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if thumb_count > 1 -%}
          <div class="midblom-fp__thumbs" role="list" aria-label="Product images">
            {{ thumbs_html }}
          </div>
        {%- endif -%}
      </div>

      <div class="midblom-fp__body">
        {%- assign review_block = section.blocks | where: 'type', 'review_text' | first -%}
        {% if review_block %}
          {%- capture review_stars -%}
            {%- for i in (1..5) -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#e98044" class="size-6">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
              </svg>

            {%- endfor -%}
          {%- endcapture -%}

          <div class="midblom-fp__review-text">
            <span class="review-stars"> {{ review_stars }} </span>
            <strong>
              {{ review_block.settings.text }}
            </strong>
          </div>
        {% endif %}

        {%- if s.tagline != blank -%}
          <span class="midblom-fp__tagline">{{ s.tagline }}</span>
        {%- endif -%}
        <h3 class="midblom-fp__title">
          {% if p %}{{ p.title }}{% else %}{{ s.fallback_title | default: 'The Midsummer System' }}{% endif %}
        </h3>
        {%- if s.subtitle != blank -%}
          <div class="midblom-fp__subtitle">{{ s.subtitle }}</div>
        {%- endif -%}

        <div class="midblom-fp__price-row">
          {%- if p -%}
            {%- if p.compare_at_price > p.price -%}
              <s>{{ p.compare_at_price | money }}</s>
            {%- endif -%}
            <strong>{{ p.price | money }}</strong>
          {%- else -%}
            {%- if s.fallback_compare != blank -%}
              <s>{{ s.fallback_compare }}</s>
            {%- endif -%}
            <strong>{{ s.fallback_price | default: '$139' }}</strong>
          {%- endif -%}
        </div>

        {%- if s.bullets != blank -%}
          <ul class="midblom-fp__bullets">
            {%- assign lines = s.bullets | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign t = line | strip -%}
              {%- if t != blank -%}
                <li>{{ t }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign bullets_block = section.blocks | where: 'type', 'bullets' | first -%}
        {% if bullets_block %}
          <ul class="midblom-fp__features">
            {%- for i in (1..7) -%}
              {% liquid
                assign icon_id = 'icon_' | append: i
                assign text_id = 'text_' | append: i
                assign icon = bullets_block.settings[icon_id]
                assign text = bullets_block.settings[text_id]
                if text == blank
                  continue
                endif
              %}
              <li class="midblom-fp__feature">
                {%- if icon != blank -%}
                  <span class="midblom-fp__feature-icon" aria-hidden="true">
                    {% render 'image', image: icon, class: 'media-block__media border-style', unset_image_tag: true %}
                  </span>
                {%- endif -%}
                <span class="midblom-fp__feature-text">{{ text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {% endif %}

        {%- if s.show_offer_options -%}
          <div class="midblom-fp__offers">
            <label class="midblom-fp__offer midblom-fp__offer--featured">
              <input type="radio" name="midblom-fp-offer" checked>
              <div>
                <strong>{{ s.offer_a_title | default: 'One-time purchase' }}</strong>
                <span>{{ s.offer_a_desc | default: 'Free shipping over $50' }}</span>
              </div>
              <span class="midblom-fp__offer-price">{{ s.offer_a_price | default: '$139' }}</span>
            </label>
            <label class="midblom-fp__offer">
              <input type="radio" name="midblom-fp-offer">
              <div>
                <strong>{{ s.offer_b_title | default: 'Bundle & save' }}</strong>
                <span>{{ s.offer_b_desc | default: 'Order any 2 — save $20' }}</span>
              </div>
              <span class="midblom-fp__offer-price">{{ s.offer_b_price | default: '$258' }}</span>
            </label>
          </div>
        {%- endif -%}

        {%- if s.show_ingredients -%}
          <button type="button" class="midblom-fp__ingr-btn" data-ingr-open="{{ modal_id }}">
            <span>{{ s.ingredients_button_text | default: 'View ingredients' }}</span>
            <svg
              viewBox="0 0 16 16"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            >
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </button>
        {%- endif -%}

        {%- if s.show_scarcity -%}
          <div class="midblom-fp__scarcity" role="alert">
            {%- if s.scarcity_icon != blank -%}
              <span class="midblom-fp__scarcity-icon" aria-hidden="true">
                {% comment %}
                  {%- render 'icon', icon: s.scarcity_icon | default: 'fire' -%}
                {% endcomment %}
                {%- render 'rusho-icons', rusho-icon: s.scarcity_icon | default: 'Plant' -%}
              </span>
            {%- endif -%}
            <div class="midblom-fp__scarcity-copy">
              {%- if s.scarcity_title != blank -%}
                <strong>{{ s.scarcity_title }}</strong>
              {%- endif -%}
              {%- if s.scarcity_body != blank -%}
                <div>{{ s.scarcity_body }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <a href="{% if p %}{{ p.url }}{% else %}{{ s.cta_link | default: '#' }}{% endif %}" class="midblom-fp__cta">
          {{ s.cta_text | default: 'Add to cart' }}
          {%- if s.show_cta_price -%}
            — {% if p %}{{ p.price | money }}{% else %}{{ s.fallback_price | default: '$139' }}{% endif %}
          {%- endif -%}
        </a>

        {%- if s.trust_line != blank -%}
          <p class="midblom-fp__trust">{{ s.trust_line }}</p>
        {%- endif -%}

        {%- if s.show_trust_row -%}
          <ul class="midblom-fp__trust-row" role="list">
            <li>
              <span class="midblom-fp__trust-icon" aria-hidden="true">
                {%- render 'rusho-icons', rusho-icon: s.trust_1_icon | default: 'Plant' -%}
              </span>
              <span class="midblom-fp__trust-label">{{ s.trust_1_label | default: 'Gentle on skin and planet' }}</span>
            </li>
            <li>
              <span class="midblom-fp__trust-icon" aria-hidden="true">
                {%- render 'rusho-icons', rusho-icon: s.trust_2_icon | default: 'Money_back' -%}
              </span>
              <span class="midblom-fp__trust-label">
                {{- s.trust_2_label | default: '60-day money-back guarantee' -}}
              </span>
            </li>
            <li>
              <span class="midblom-fp__trust-icon" aria-hidden="true">
                {%- render 'rusho-icons', rusho-icon: s.trust_3_icon | default: 'Free_shipping' -%}
              </span>
              <span class="midblom-fp__trust-label">{{ s.trust_3_label | default: 'Free shipping over $50' }}</span>
            </li>
          </ul>
        {%- endif -%}
      </div>
    </article>
  </div>

  {%- if s.show_ingredients -%}
    <div
      class="midblom-fp__modal"
      id="{{ modal_id }}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ modal_id }}-title"
      aria-hidden="true"
    >
      <div class="midblom-fp__modal-backdrop" data-ingr-close="{{ modal_id }}"></div>
      <div class="midblom-fp__modal-panel" tabindex="-1">
        <button
          type="button"
          class="midblom-fp__modal-close"
          data-ingr-close="{{ modal_id }}"
          aria-label="Close ingredients"
        >
          <svg
            viewBox="0 0 16 16"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          >
            <path d="M3 3l10 10M13 3L3 13"/>
          </svg>
        </button>

        <div class="midblom-fp__modal-content">
          <header class="midblom-fp__modal-header">
            {%- if s.modal_eyebrow != blank -%}
              <span class="midblom-fp__modal-eyebrow">{{ s.modal_eyebrow }}</span>
            {%- endif -%}
            {%- if s.modal_heading != blank -%}
              <h2 id="{{ modal_id }}-title" class="midblom-fp__modal-heading">{{ s.modal_heading }}</h2>
            {%- endif -%}
            {%- if s.modal_subheading != blank -%}
              <div class="midblom-fp__modal-sub">{{ s.modal_subheading }}</div>
            {%- endif -%}
          </header>

          <div class="midblom-fp__ingr-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'ingredient' -%}
                {% liquid
                  assign b = block.settings
                %}
                <div class="midblom-fp__ingr-card" {{ block.shopify_attributes }}>
                  <div class="midblom-fp__ingr-icon" aria-hidden="true">
                    {%- if b.icon_image != blank -%}
                      <img
                        src="{{ b.icon_image | image_url: width: 200 }}"
                        alt=""
                        width="80"
                        height="80"
                        loading="lazy"
                      >
                    {%- else -%}
                      {% comment %}
                        {%- render 'icon', icon: b.icon -%}
                      {% endcomment %}

                      {%- assign ingredient_name = b.name | handleize -%}

                      {%- case ingredient_name -%}
                        {%- when 'cloudberry' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Cloudberry' -%}
                        {%- when 'lingonberry' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Lingonberry' -%}
                        {%- when 'birch-extract' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Birch-extract' -%}
                        {%- when 'sea-buckthorn' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Sea-buckthorn' -%}
                        {%- when 'arctic-crowberry' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Arctic-crowberry' -%}
                        {%- when 'vitamin-e' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Vitamin-E' -%}
                        {%- when 'rosehip' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Rosehip' -%}
                        {%- when 'squalane' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Squalane' -%}
                        {%- when 'beeswax' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Beeswax' -%}
                        {%- when 'chamomile' -%}
                          {%- render 'rusho-icons', rusho-icon: 'Chamomile' -%}
                      {%- endcase -%}
                    {%- endif -%}
                  </div>
                  {%- if b.tag != blank -%}
                    <span class="midblom-fp__ingr-tag">{{ b.tag }}</span>
                  {%- endif -%}
                  {%- if b.name != blank -%}
                    <h3 class="midblom-fp__ingr-name">{{ b.name }}</h3>
                  {%- endif -%}
                  {%- if b.description != blank -%}
                    <div class="midblom-fp__ingr-desc">{{ b.description }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if s.show_promise_strip -%}
            <ul class="midblom-fp__promise-strip" role="list">
              <li>
                <span aria-hidden="true">{%- render 'rusho-icons', rusho-icon: 'presticide' -%}</span
                ><span>{{ s.promise_1 | default: '0 PESTICIDES' }}</span>
              </li>
              <li>
                <span aria-hidden="true">{%- render 'rusho-icons', rusho-icon: 'hormone-disruptors' -%}</span
                ><span>{{ s.promise_2 | default: '0 HORMONE DISRUPTORS' }}</span>
              </li>
              <li>
                <span aria-hidden="true">{%- render 'rusho-icons', rusho-icon: '100-netural' -%}</span
                ><span>{{ s.promise_3 | default: '100% NATURAL' }}</span>
              </li>
              <li>
                <span aria-hidden="true">{%- render 'rusho-icons', rusho-icon: '3rd-party-tested' -%}</span
                ><span>{{ s.promise_4 | default: '3RD PARTY TESTED' }}</span>
              </li>
            </ul>
          {%- endif -%}

          {%- if s.inci_intro != blank or s.inci_list != blank -%}
            <div class="midblom-fp__inci">
              {%- if s.inci_intro != blank -%}
                <div class="midblom-fp__inci-intro">{{ s.inci_intro }}</div>
              {%- endif -%}
              {%- if s.inci_list != blank -%}
                <div class="midblom-fp__inci-list">{{ s.inci_list }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <button type="button" class="midblom-fp__modal-close-bottom" data-ingr-close="{{ modal_id }}">
            {{ s.modal_close_text | default: 'Close' }}
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .midblom-fp {
    width: 100%;
    background: var(--color-background);
    color: var(--color-foreground);
    padding: clamp(32px, 4.5vw, 64px) 0;
  }
  .midblom-fp__inner {
    max-width: var(--page-width, 1280px);
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  /* DESKTOP — narrower card so it reads like Froya's compact featured product */
  @media (min-width: 990px) {
    .midblom-fp__inner {
      max-width: 960px;
    }
  }
  .midblom-fp__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    margin-bottom: 32px;
  }
  .midblom-fp__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .midblom-fp__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
    font-weight: 500;
    line-height: 1.15;
    max-width: 720px;
    color: var(--color-foreground-heading);
  }
  .midblom-fp__card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  @media (max-width: 749px) {
    .midblom-fp__card {
      grid-template-columns: 1fr;
    }
  }

  /* Media wrap = main image + thumbnail strip stacked vertically */
  .midblom-fp__media-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .midblom-fp__media {
    position: relative;
    aspect-ratio: 1/1;
    background: #c4d8dc;
    border-radius: 8px;
    overflow: hidden;
  }
  /* DESKTOP — cap product image so it doesn't overshoot the text column */
  @media (min-width: 990px) {
    .midblom-fp__media {
      aspect-ratio: 4/5;
      max-height: 460px;
    }
  }
  .midblom-fp__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .midblom-fp__media-ph {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: rgba(22, 45, 58, 0.4);
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    border: 1px dashed rgba(22, 45, 58, 0.25);
  }
  .midblom-fp__badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: #edd020;
    color: #162d3a;
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    font-weight: 600;
  }

  /* ───── Thumbnail carousel (Froya-style) ─────
     Horizontal scrollable row, square thumbs, click swaps the main image,
     active thumb gets a primary-color border. */
  .midblom-fp__thumbs {
    list-style: none;
    margin: 0;
    padding: 4px 2px;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(13, 30, 40, 0.25) transparent;
  }
  .midblom-fp__thumbs::-webkit-scrollbar {
    height: 4px;
  }
  .midblom-fp__thumbs::-webkit-scrollbar-thumb {
    background: rgba(13, 30, 40, 0.25);
    border-radius: 4px;
  }
  .midblom-fp__thumbs::-webkit-scrollbar-track {
    background: transparent;
  }
  .midblom-fp__thumb {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    padding: 0;
    margin: 0;
    border-radius: 6px;
    border: 2px solid transparent;
    background: var(--color-background);
    overflow: hidden;
    cursor: pointer;
    scroll-snap-align: start;
    position: relative;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .midblom-fp__thumb:hover {
    transform: translateY(-1px);
    border-color: rgba(13, 30, 40, 0.2);
  }
  .midblom-fp__thumb:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .midblom-fp__thumb.is-active {
    border-color: var(--color-primary, #edd020);
  }
  .midblom-fp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Slightly larger thumbs on desktop */
  @media (min-width: 990px) {
    .midblom-fp__thumb {
      width: 72px;
      height: 72px;
    }
    .midblom-fp__thumbs {
      gap: 10px;
    }
  }
  .midblom-fp__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .midblom-fp__tagline {
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .midblom-fp__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-foreground-heading);
  }
  .midblom-fp__subtitle {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    opacity: 0.85;
  }
  .midblom-fp__price-row {
    display: inline-flex;
    gap: 10px;
    align-items: baseline;
    font-size: 1.25rem;
    padding: 4px 0;
  }
  .midblom-fp__price-row s {
    opacity: 0.5;
    font-weight: 400;
  }
  .midblom-fp__price-row strong {
    font-weight: 600;
  }
  .midblom-fp__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
