{% javascript %}
  (function () {
    function open(modal) {
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('midblom-modal-open');
      const panel = modal.querySelector('.midblom-fp__modal-panel');
      if (panel) panel.focus();
    }
    function close(modal) {
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('midblom-modal-open');
    }
    document.addEventListener('click', function (e) {
      const openBtn = e.target.closest('[data-ingr-open]');
      if (openBtn) {
        const modal = document.getElementById(openBtn.dataset.ingrOpen);
        if (modal) open(modal);
        return;
      }
      const closeBtn = e.target.closest('[data-ingr-close]');
      if (closeBtn) {
        const modal = document.getElementById(closeBtn.dataset.ingrClose);
        if (modal) close(modal);
      }

      // ─── Thumbnail click → swap main image ───
      const thumb = e.target.closest('[data-fp-thumb]');
      if (thumb) {
        const newSrc = thumb.dataset.img;
        if (!newSrc) return;
        // Find the media wrap that contains both the thumbs and the main img
        const wrap = thumb.closest('.midblom-fp__media-wrap');
        if (!wrap) return;
        const mainImg = wrap.querySelector('[data-fp-main-img]');
        if (mainImg) {
          mainImg.src = newSrc;
          // Also clear srcset so the swap takes effect immediately
          if (mainImg.hasAttribute('srcset')) mainImg.removeAttribute('srcset');
        }
        // Update active state on the thumb row
        const row = thumb.parentElement;
        if (row) {
          row.querySelectorAll('[data-fp-thumb]').forEach(function (t) {
            t.classList.toggle('is-active', t === thumb);
          });
        }
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.midblom-fp__modal[aria-hidden="false"]').forEach(close);
      }
    });
  })();
{% endjavascript %}

